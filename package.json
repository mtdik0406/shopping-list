{
  "name": "shopping-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run lint:style && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@lucide/vue": "1.78.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node26": "26.0.2",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.23.0"
}
